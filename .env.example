# VulnCheck Local — local configuration
# Copy this file to ".env" and adjust if needed:
#   Windows (cmd):   copy .env.example .env
#   Windows (PS):    Copy-Item .env.example .env
#   macOS/Linux:     cp .env.example .env

# SQLite database path — relative to prisma/schema.prisma
# (resolves to <project>/db/custom.db on every OS)
DATABASE_URL=file:../db/custom.db
